// GPU batch quality helpers. / GPU 批量质量辅助。
// Metrics exclude final compressor loss. / 不含最终压缩损失。
#pragma kernel KDownsample
#pragma kernel KSsimTile
#pragma kernel KDeltaETile
#pragma kernel KAlpha
#pragma kernel KNormal

Texture2D<float4> _Src;
Texture2D<float4> _Dst;
RWStructuredBuffer<float> _Out;
float4 _Params; // x=width y=height z=cutoff w=srgb
uint _Role; // 0 albedo 1 normal 2 mask 3 gray

float SrgbToLinear(float c)
{
    return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);
}

float3 ToLinear(float3 c, float srgb)
{
    if (srgb < 0.5) return c;
    return float3(SrgbToLinear(c.r), SrgbToLinear(c.g), SrgbToLinear(c.b));
}

float Luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }

[numthreads(8,8,1)]
void KDownsample(uint3 id : SV_DispatchThreadID)
{
    // unused placeholder; blit used for resample
}

[numthreads(8,8,1)]
void KSsimTile(uint3 id : SV_DispatchThreadID)
{
    uint w = (uint)_Params.x;
    uint h = (uint)_Params.y;
    if (id.x >= w || id.y >= h) return;
    float3 a = ToLinear(_Src[id.xy].rgb, _Params.w);
    float3 b = ToLinear(_Dst[id.xy].rgb, _Params.w);
    float la = Luma(a), lb = Luma(b);
    uint idx = id.y * w + id.x;
    _Out[idx] = la;
    _Out[idx + w * h] = lb;
}

float3 RgbToLab(float3 rgb)
{
    float r = rgb.r, g = rgb.g, b = rgb.b;
    float x = r * 0.4124 + g * 0.3576 + b * 0.1805;
    float y = r * 0.2126 + g * 0.7152 + b * 0.0722;
    float z = r * 0.0193 + g * 0.1192 + b * 0.9505;
    x /= 0.95047; z /= 1.08883;
    float xp = x > 0.008856 ? pow(x, 1.0 / 3.0) : 7.787 * x + 16.0 / 116.0;
    float yp = y > 0.008856 ? pow(y, 1.0 / 3.0) : 7.787 * y + 16.0 / 116.0;
    float zp = z > 0.008856 ? pow(z, 1.0 / 3.0) : 7.787 * z + 16.0 / 116.0;
    return float3(116.0 * yp - 16.0, 500.0 * (xp - yp), 200.0 * (yp - zp));
}

[numthreads(8,8,1)]
void KDeltaETile(uint3 id : SV_DispatchThreadID)
{
    uint w = (uint)_Params.x;
    uint h = (uint)_Params.y;
    if (id.x >= w || id.y >= h) return;
    float3 a = RgbToLab(ToLinear(_Src[id.xy].rgb, _Params.w));
    float3 b = RgbToLab(ToLinear(_Dst[id.xy].rgb, _Params.w));
    float d = length(a - b); // CIE76 approx on GPU; CPU path uses CIEDE2000
    _Out[id.y * w + id.x] = d;
}

[numthreads(8,8,1)]
void KAlpha(uint3 id : SV_DispatchThreadID)
{
    uint w = (uint)_Params.x;
    uint h = (uint)_Params.y;
    if (id.x >= w || id.y >= h) return;
    float aa = _Src[id.xy].a;
    float ba = _Dst[id.xy].a;
    float cutoff = _Params.z;
    float iou = (aa >= cutoff && ba >= cutoff) ? 1 : ((aa >= cutoff || ba >= cutoff) ? 0 : 1);
    float rmse = (aa - ba) * (aa - ba);
    _Out[id.y * w + id.x] = iou;
    _Out[id.y * w + id.x + w * h] = rmse;
}

[numthreads(8,8,1)]
void KNormal(uint3 id : SV_DispatchThreadID)
{
    uint w = (uint)_Params.x;
    uint h = (uint)_Params.y;
    if (id.x >= w || id.y >= h) return;
    float3 na = normalize(_Src[id.xy].xyz * 2 - 1);
    float3 nb = normalize(_Dst[id.xy].xyz * 2 - 1);
    float ang = acos(saturate(dot(na, nb))) * 57.2957795;
    _Out[id.y * w + id.x] = ang;
}
