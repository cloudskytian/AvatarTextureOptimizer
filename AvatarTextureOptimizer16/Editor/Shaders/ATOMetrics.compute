// AvatarTextureOptimizer quality metrics kernels.
// 质量指标计算内核：sRGB->linear、预乘 alpha、SSIM 窗口统计、CIEDE2000、法线角度、灰度 RMSE。
// The metric evaluation is the single source of truth; run entirely on the GPU to avoid
// CPU/GPU floating-point divergence. / 指标求值唯一真相源，全部在 GPU 上运行，避免 CPU/GPU 浮点分歧。

#pragma kernel LinearizeAndDeltaE
#pragma kernel SSIMWindow
#pragma kernel NormalAngle
#pragma kernel GrayRmse

RWStructuredBuffer<float2> _Lum;        // x=ref luminance, y=cand luminance
RWStructuredBuffer<float> _DeltaE;      // per-pixel CIEDE2000
RWStructuredBuffer<float> _AlphaErr;    // per-pixel alpha squared error
RWStructuredBuffer<float> _SSIMOut;     // per-window ssim (lum*cs)
RWStructuredBuffer<float> _NormalErr;   // per-pixel angular error (degrees)
RWStructuredBuffer<float> _GrayErr;     // per-pixel gray squared error (worst channel)

int _Width;
int _Height;
int _WindowSize;      // 8
int _NormalEncoding;  // 0 = DXT5nm (x in a, y in g), 1 = BC5 (x in r, y in g), 2 = RGB (unpacked)
int _GrayChannel;     // bitmask of used channels (R=1,G=2,B=4,A=8)

Texture2D<float4> _RefTex;
Texture2D<float4> _CandTex;
SamplerState _LinearClamp;

float3 sRGBToLinear(float3 c)
{
    // sRGB -> linear approximation / sRGB -> 线性近似
    float3 lo = c / 12.92;
    float3 hi = pow(max((c + 0.055) / 1.055, 0.0), 2.4);
    return lerp(lo, hi, step(0.04045, c));
}

float3 rgb2lab(float3 linear)
{
    // linear sRGB -> XYZ -> LAB (D65) / 线性 sRGB -> XYZ -> LAB (D65)
    float3 xyz;
    xyz.x = dot(linear, float3(0.4124564, 0.3575761, 0.1804375));
    xyz.y = dot(linear, float3(0.2126729, 0.7151522, 0.0721750));
    xyz.z = dot(linear, float3(0.0193339, 0.1191920, 0.9503041));
    xyz /= float3(0.95047, 1.0, 1.08883);

    float3 f;
    f.x = xyz.x > 0.008856 ? pow(xyz.x, 1.0/3.0) : (903.3*xyz.x + 16.0)/116.0;
    f.y = xyz.y > 0.008856 ? pow(xyz.y, 1.0/3.0) : (903.3*xyz.y + 16.0)/116.0;
    f.z = xyz.z > 0.008856 ? pow(xyz.z, 1.0/3.0) : (903.3*xyz.z + 16.0)/116.0;

    float3 lab;
    lab.x = 116.0*f.y - 16.0;
    lab.y = 500.0*(f.x - f.y);
    lab.z = 200.0*(f.y - f.z);
    return lab;
}

// CIEDE2000 color difference / CIEDE2000 色差
float cie2000(float3 lab1, float3 lab2)
{
    float L1 = lab1.x, a1 = lab1.y, b1 = lab1.z;
    float L2 = lab2.x, a2 = lab2.y, b2 = lab2.z;

    float C1 = sqrt(a1*a1 + b1*b1);
    float C2 = sqrt(a2*a2 + b2*b2);
    float Cbar = (C1 + C2) * 0.5;
    float G = 0.5 * (1.0 - sqrt(pow(Cbar, 7.0) / (pow(Cbar, 7.0) + pow(25.0, 7.0))));
    float a1p = (1.0 + G) * a1;
    float a2p = (1.0 + G) * a2;
    float C1p = sqrt(a1p*a1p + b1*b1);
    float C2p = sqrt(a2p*a2p + b2*b2);

    float h1p = atan2(b1, a1p); if (h1p < 0.0) h1p += 6.283185307;
    float h2p = atan2(b2, a2p); if (h2p < 0.0) h2p += 6.283185307;

    float dLp = L2 - L1;
    float dCp = C2p - C1p;
    float dh;
    if (C1p*C2p == 0.0) dh = 0.0;
    else if (abs(h2p - h1p) <= 3.141592654) dh = h2p - h1p;
    else if (h2p - h1p > 3.141592654) dh = h2p - h1p - 6.283185307;
    else dh = h2p - h1p + 6.283185307;
    float dHp = 2.0 * sqrt(C1p*C2p) * sin(dh/2.0);

    float Lbarp = (L1 + L2) * 0.5;
    float Cbarp = (C1p + C2p) * 0.5;
    float hbarp;
    if (C1p*C2p == 0.0) hbarp = h1p + h2p;
    else if (abs(h1p - h2p) <= 3.141592654) hbarp = (h1p + h2p) * 0.5;
    else if (h1p + h2p < 6.283185307) hbarp = (h1p + h2p + 6.283185307) * 0.5;
    else hbarp = (h1p + h2p - 6.283185307) * 0.5;

    float T = 1.0 - 0.17*cos(hbarp - 0.523598776) + 0.24*cos(2.0*hbarp)
              + 0.32*cos(3.0*hbarp + 0.104719755) - 0.20*cos(4.0*hbarp - 1.099557429);
    float SL = 1.0 + 0.015*pow(Lbarp - 50.0, 2.0) / sqrt(20.0 + pow(Lbarp - 50.0, 2.0));
    float SC = 1.0 + 0.045*Cbarp;
    float SH = 1.0 + 0.015*Cbarp*T;
    float RT = -2.0 * sqrt(pow(Cbarp, 7.0)/(pow(Cbarp, 7.0) + pow(25.0, 7.0)))
               * sin(1.047197551 * exp(-pow((hbarp - 4.799655443)/0.436332313, 2.0)));

    return sqrt(pow(dLp/SL, 2.0) + pow(dCp/SC, 2.0) + pow(dHp/SH, 2.0) + RT*(dCp/SC)*(dHp/SH));
}

[numthreads(8,8,1)]
void LinearizeAndDeltaE(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(_Width, _Height);

    float4 ref = _RefTex.SampleLevel(_LinearClamp, uv, 0);
    float4 cand = _CandTex.SampleLevel(_LinearClamp, uv, 0);

    float3 refLin = sRGBToLinear(ref.rgb);
    float3 candLin = sRGBToLinear(cand.rgb);

    float ra = ref.a, ca = cand.a;

    int idx = id.y * _Width + id.x;
    _Lum[idx] = float2(dot(refLin, float3(0.2126, 0.7152, 0.0722)),
                       dot(candLin, float3(0.2126, 0.7152, 0.0722)));
    _DeltaE[idx] = cie2000(rgb2lab(refLin), rgb2lab(candLin));
    _AlphaErr[idx] = (ca - ra) * (ca - ra);
}

[numthreads(8,8,1)]
void SSIMWindow(uint3 id : SV_DispatchThreadID)
{
    int cols = (_Width + _WindowSize - 1) / _WindowSize;
    int rows = (_Height + _WindowSize - 1) / _WindowSize;
    int wCount = cols * rows;
    if ((int)id.x >= wCount) return;
    int wx = (int)id.x % cols;
    int wy = (int)id.x / cols;

    float mx = 0.0, my = 0.0, mxx = 0.0, myy = 0.0, mxy = 0.0;
    float n = 0.0;
    for (int dy = 0; dy < _WindowSize; dy++)
    for (int dx = 0; dx < _WindowSize; dx++)
    {
        int px = wx*_WindowSize + dx, py = wy*_WindowSize + dy;
        if (px >= _Width || py >= _Height) continue;
        float2 lum = _Lum[py*_Width + px];
        float rl = lum.x, l = lum.y;
        mx += rl; my += l; mxx += rl*rl; myy += l*l; mxy += rl*l;
        n += 1.0;
    }
    if (n < 1.0) { _SSIMOut[id.x] = 1.0; return; }
    mx /= n; my /= n; mxx /= n; myy /= n; mxy /= n;
    float vx = mxx - mx*mx;
    float vy = myy - my*my;
    float vxy = mxy - mx*my;
    float C1 = 0.0001, C2 = 0.0009;
    float lum = (2.0*mx*my + C1) / (mx*mx + my*my + C1);
    float cs = (2.0*sqrt(max(vx*vy, 0.0)) + C2) / (max(vx, 0.0) + max(vy, 0.0) + C2);
    _SSIMOut[id.x] = lum * cs;
}

float3 DecodeNormal(float4 c)
{
    // Decode a packed normal map back to a unit normal. / 将打包的法线贴图解码为单位法线。
    float2 xy;
    if (_NormalEncoding == 1)      xy = float2(c.r, c.g);      // BC5
    else if (_NormalEncoding == 0) xy = float2(c.a, c.g);      // DXT5nm
    else                           return normalize(c.rgb * 2.0 - 1.0); // RGB
    float3 n = float3(xy * 2.0 - 1.0, 0.0);
    n.z = sqrt(max(1.0 - dot(n.xy, n.xy), 0.0));
    return n;
}

[numthreads(8,8,1)]
void NormalAngle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(_Width, _Height);
    float4 ref = _RefTex.SampleLevel(_LinearClamp, uv, 0);
    float4 cand = _CandTex.SampleLevel(_LinearClamp, uv, 0);
    float3 nRef = DecodeNormal(ref);
    float3 nCand = DecodeNormal(cand);
    float d = saturate(dot(nRef, nCand));
    _NormalErr[id.y*_Width+id.x] = degrees(acos(d));
}

[numthreads(8,8,1)]
void GrayRmse(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(_Width, _Height);
    float4 ref = _RefTex.SampleLevel(_LinearClamp, uv, 0);
    float4 cand = _CandTex.SampleLevel(_LinearClamp, uv, 0);

    // worst squared error over used channels / 被使用通道上最差平方误差
    float worst = 0.0;
    if ((_GrayChannel & 1) != 0) { float e = cand.r - ref.r; worst = max(worst, e * e); }
    if ((_GrayChannel & 2) != 0) { float e = cand.g - ref.g; worst = max(worst, e * e); }
    if ((_GrayChannel & 4) != 0) { float e = cand.b - ref.b; worst = max(worst, e * e); }
    if ((_GrayChannel & 8) != 0) { float e = cand.a - ref.a; worst = max(worst, e * e); }
    _GrayErr[id.y*_Width+id.x] = worst;
}
