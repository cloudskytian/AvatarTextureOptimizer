#pragma kernel KDownsamplePremul
#pragma kernel KLuma

// GPU helpers for quality evaluation. CPU Burst path is the fallback.
// 质量评估 GPU 辅助核。CPU Burst 为回退。

RWTexture2D<float4> _Src;
RWTexture2D<float4> _Dst;
uint _SrcW, _SrcH, _DstW, _DstH;
uint _Premul;
uint _Linearize;

float3 ToLinear(float3 s)
{
    return float3(
        s.r <= 0.04045 ? s.r / 12.92 : pow((s.r + 0.055) / 1.055, 2.4),
        s.g <= 0.04045 ? s.g / 12.92 : pow((s.g + 0.055) / 1.055, 2.4),
        s.b <= 0.04045 ? s.b / 12.92 : pow((s.b + 0.055) / 1.055, 2.4));
}

[numthreads(8,8,1)]
void KDownsamplePremul(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DstW || id.y >= _DstH) return;
    float u = (id.x + 0.5) * _SrcW / (float)_DstW - 0.5;
    float v = (id.y + 0.5) * _SrcH / (float)_DstH - 0.5;
    int x0 = clamp((int)floor(u), 0, (int)_SrcW - 1);
    int y0 = clamp((int)floor(v), 0, (int)_SrcH - 1);
    int x1 = min(x0 + 1, (int)_SrcW - 1);
    int y1 = min(y0 + 1, (int)_SrcH - 1);
    float tx = saturate(u - x0);
    float ty = saturate(v - y0);
    float4 c00 = _Src[uint2(x0, y0)];
    float4 c10 = _Src[uint2(x1, y0)];
    float4 c01 = _Src[uint2(x0, y1)];
    float4 c11 = _Src[uint2(x1, y1)];
    if (_Linearize != 0)
    {
        c00.rgb = ToLinear(c00.rgb); c10.rgb = ToLinear(c10.rgb);
        c01.rgb = ToLinear(c01.rgb); c11.rgb = ToLinear(c11.rgb);
    }
    if (_Premul != 0)
    {
        c00.rgb *= c00.a; c10.rgb *= c10.a; c01.rgb *= c01.a; c11.rgb *= c11.a;
    }
    float4 c0 = lerp(c00, c10, tx);
    float4 c1 = lerp(c01, c11, tx);
    float4 c = lerp(c0, c1, ty);
    if (_Premul != 0 && c.a > 1e-6) c.rgb /= c.a;
    _Dst[id.xy] = c;
}

RWStructuredBuffer<float> _Luma;
[numthreads(8,8,1)]
void KLuma(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _SrcW || id.y >= _SrcH) return;
    float4 c = _Src[id.xy];
    if (_Linearize != 0) c.rgb = ToLinear(c.rgb);
    _Luma[id.y * _SrcW + id.x] = dot(c.rgb, float3(0.2126, 0.7152, 0.0722));
}
